# Copy to `.env.local`. Both values are read in the Node process only, never
# shipped to the browser: neither is prefixed `NEXT_PUBLIC_`.

# Where the Python API listens. The dashboard reaches it server-side, so this
# stays a loopback address -- the API requires a loopback `Host` header while
# synthetic-data mode is on, and sends no CORS headers for a browser to use.
API_BASE_URL=http://127.0.0.1:8000

# Which clinic to show. Optional: with no value the first clinic the API lists
# is used, which is the only one a synthetic-data install has. Becomes
# redundant once sign-in arrives and the clinic comes from the session.
# CLINIC_ID=
